#!/bin/bash
#
# spark - fleet manager launcher (wraps spark.py).
# Run on the MASTER node. Usage:
#   ./spark scan [--tokens 1M] [--json]
#   ./spark apply -f fleet.yaml [--execute]
#   ./spark down  -f fleet.yaml [--execute]
#
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pick the first interpreter that actually RUNS. `command -v python3` is not enough on
# Windows: WindowsApps ships a python3 stub that resolves fine and then refuses to execute.
# A local .venv wins so the fleet manager uses the checkout's deps, not the system's.
for p in "$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/.venv/Scripts/python.exe" python3 python; do
    "$p" -c '' 2>/dev/null && { PYTHON=$p; break; }
done
[ -n "$PYTHON" ] || { echo "Error: no working Python 3 found." >&2; exit 1; }

# spark apply needs PyYAML; install on demand (same as run-recipe.sh).
if ! "$PYTHON" -c "import yaml" 2>/dev/null; then
    "$PYTHON" -m pip install --quiet pyyaml || {
        echo "Error: failed to install PyYAML (needed for fleet.yaml). Try: pip install pyyaml" >&2
        exit 1
    }
fi

exec "$PYTHON" "$SCRIPT_DIR/spark.py" "$@"
